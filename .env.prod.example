POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
ORDER_DB=Host=postgres;Port=5432;Database=orderservice;Username=postgres;Password=replace-me
SHIPMENT_DB=Host=postgres;Port=5432;Database=shipments;Username=postgres;Password=replace-me
AUTH_ISSUER=OrderService
AUTH_AUDIENCE=OrderService
AUTH_SIGNING_KEY=replace-with-at-least-32-byte-signing-key
AUTH_TOKEN_LIFETIME_MINUTES=60
ORDER_IMAGE=ghcr.io/wenlianghuang/order-poc-order:latest
SHIPMENT_IMAGE=ghcr.io/wenlianghuang/order-poc-shipment:latest
